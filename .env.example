# Frontend (public, safe to expose) — from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Server only (set in Vercel → Settings → Environment Variables; NEVER prefix with VITE_)
ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_URL=...   (only for cloud-sync mode)
# SUPABASE_ANON_KEY=...
# AI_MODEL=claude-sonnet-5-5
# Local-only mode: choose any passcode; the app asks for it once on each device
APP_PASSCODE=choose-a-passcode
